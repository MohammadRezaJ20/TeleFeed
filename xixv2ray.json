    {
      "id": 0,
      "message": "یه جوری سرور آماده کردم منتظر قطعی نتم که فقط بمب اتم می‌تونه قطعم کنه.",
      "date": "2026-10-15T20:40:31Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 7400,
      "forwards": 0,
