      "sender_id": 0,
      "sender_name": "🍓 XIX"
    },
    {
      "id": 0,
      "message": "جام جهانی؟ ما خودمون جنگ جهانی داریم.",
      "date": "2026-07-19T22:12:41Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
