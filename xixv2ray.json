      "sender_name": "🍓 XIX"
    },
    {
      "id": 0,
      "message": "کانفیگ نخرید الکی، پولتون بذارید تو جیبتون، اصلا برید بستنی بخرید، نت قطع شد کانفیگ رایگان می‌ذارم مثل قدیم.",
      "date": "2026-10-15T20:41:56Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 8109,
      "forwards": 0,
