      "sender_id": 0,
      "sender_name": "🍓 XIX"
    },
    {
      "id": 0,
      "message": "شنیدم نفر بعدی که قرار گریه کنه ما هستیم.",
      "date": "2026-07-19T22:11:44Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 6370,
      "forwards": 0,
