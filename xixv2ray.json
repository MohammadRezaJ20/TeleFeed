      "sender_id": 0,
      "sender_name": "🍓 XIX"
    },
    {
      "id": 0,
      "message": "نفرین مسی پشت هر خاورمیانه‌ای که امشب ازش متنفربود هست.",
      "date": "2026-07-19T22:13:52Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
