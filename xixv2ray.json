    },
    {
      "id": 0,
      "message": "یه جوری مسی ناراحت بود انگار قرار بعد بازی نتش قطع بشه.",
      "date": "2026-07-19T22:10:50Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 7000,
      "forwards": 0,
